# =============================================================================
# Pica Backend Environment Template
# Copy this file to `backend/.env` before starting `uvicorn app.main:app`.
# NEVER commit `backend/.env` with real credentials.
# =============================================================================

PICA_HOST=127.0.0.1
PICA_PORT=8000
PICA_AUTH_ENABLED=false
# PICA_JWT_SECRET=change-me-before-enabling-auth

PICA_SQLITE_PATH=data/pica.db
PICA_WORK_DIR=data/work
PICA_SAMPLE_INTERVAL_SECONDS=5.0
PICA_MAX_UPLOAD_FILES=20
PICA_WORKER_ENABLED=true
# PICA_FFMPEG_PATH=

# Platform S3 / MinIO (stores thumbnails, video covers, and hosted originals)
# PICA_S3_ENDPOINT=http://127.0.0.1:9000
# PICA_S3_REGION=us-east-1
# PICA_S3_BUCKET=pica-media
# PICA_S3_ACCESS_KEY=your-minio-access-key
# PICA_S3_SECRET_KEY=your-minio-secret-key

# Milvus REST v2
# PICA_MILVUS_URI=http://127.0.0.1:19530
# PICA_MILVUS_DB=default
# PICA_MILVUS_USER=root
# PICA_MILVUS_PASSWORD=your-milvus-password
# PICA_VECTOR_PROFILE=default

# Remote HTTP Encoder (recommended) or switch to local_onnx
# PICA_ENCODER_BACKEND=remote_http
# PICA_CLIP_HTTP_BASE_URL=http://127.0.0.1:8001
# PICA_CLIP_HTTP_TIMEOUT_SECONDS=30.0
# PICA_MODEL_FAMILY=chinese_clip
# PICA_MODEL_ARCHITECTURE=ViT-B-16
# PICA_MODEL_ID=chinese-clip-vit-b-16
# PICA_MODEL_VERSION=int8_dynamic
# PICA_MODEL_DIM=512

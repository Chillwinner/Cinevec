# =============================================================================
# CineVec 一键 Docker Compose 配置模板
# 使用方式：
#   1. cp .env.docker.example .env
#   2. 填入你的向量编码服务地址 PICA_CLIP_HTTP_BASE_URL（如宿主机跑在 8001 端口，填 http://host.docker.internal:8001）
#   3. docker compose up -d
#   4. 浏览器打开 http://localhost:5174
#
# 说明：
#   - Milvus 已默认内置 Milvus Lite（data/milvus_lite.db），无需额外装 Milvus 集群
#   - MinIO 已默认随 Compose 启动并自动创建 cinevec-media 桶且自动登记为平台存储
# =============================================================================

# 端口（如本机冲突可修改）
CINEVEC_WEB_PORT=5174
CINEVEC_API_PORT=8008
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO 默认账号密码（生产环境请修改）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
PICA_S3_BUCKET=cinevec-media

# 多模态编码模型服务（核心必填项：填好后即可向量化与语义搜索）
PICA_ENCODER_BACKEND=remote_http
PICA_CLIP_HTTP_BASE_URL=http://host.docker.internal:8001
PICA_MODEL_FAMILY=embeddinggemma2
PICA_MODEL_ARCHITECTURE=google/embeddinggemma-2
PICA_MODEL_ID=embeddinggemma-2
PICA_MODEL_VERSION=v1
PICA_MODEL_DIM=768
PICA_PREPROCESS_VERSION=full_frame_passthrough_v1
PICA_ENCODER_CONTRACT_STATUS=verified
PICA_TASK_PREFIX_APPLIED_BY=server

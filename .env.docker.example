# =============================================================================
# CineVec 一键 Docker Compose 配置模板
#
# 使用方式：
#   1. cp .env.docker.example .env
#   2. （可选）如果 Hugging Face 下载 google/embeddinggemma-2 需要授权，在 HF_TOKEN 填入令牌
#   3. 启动全部积木：
#      - CPU / 默认：docker compose up -d
#      - NVIDIA GPU：docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
#   4. 浏览器打开 http://localhost:5174
#
# 默认内置积木：
#   - MinIO 对象存储（自动创建 cinevec-media 桶并登记为平台存储）
#   - Milvus Lite 本地单文件向量库（data/milvus_lite.db，无需运维 Milvus 集群）
#   - EmbeddingGemma 2 独立编码容器（http://encoder:8001，默认裁剪音频塔，激活仅 ~440M 参数）
# =============================================================================

# 端口（如本机端口冲突可修改）
CINEVEC_WEB_PORT=5174
CINEVEC_API_PORT=8008
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ENCODER_PORT=8001

# -----------------------------------------------------------------------------
# 1. 多模态编码模型（默认启用 Compose 内置 EmbeddingGemma 2 容器）
# -----------------------------------------------------------------------------
PICA_ENCODER_BACKEND=remote_http
# 默认指向 Compose 内部容器；若使用外置/Mac MPS/远端模型，可改为：
#   http://host.docker.internal:8001  （宿主机原生跑 MPS / GPU）
#   http://192.168.1.50:8001          （局域网另一台显卡机器）
PICA_CLIP_HTTP_BASE_URL=http://encoder:8001

PICA_MODEL_FAMILY=embeddinggemma2
PICA_MODEL_ARCHITECTURE=google/embeddinggemma-2
PICA_MODEL_ID=embeddinggemma-2
PICA_MODEL_VERSION=v1
PICA_MODEL_DIM=768
PICA_PREPROCESS_VERSION=full_frame_passthrough_v1
PICA_ENCODER_CONTRACT_STATUS=verified
PICA_TASK_PREFIX_APPLIED_BY=server

# EmbeddingGemma 2 容器运行参数（禁止 float16，仅支持 auto/bfloat16/float32）
EMBED_DEVICE=auto
EMBED_DTYPE=auto
# 关闭音频编码塔以节省约 300M 参数内存（仅文本 + 图像/视频抽帧语义检索时强烈推荐 true）
EMBED_DISABLE_AUDIO=true
# 如果 Hugging Face 模型页面需要同意条款与 Token，请填写你的 Read Token
HF_TOKEN=
# 国内或代理镜像地址（可选，例如 https://hf-mirror.com）
HF_ENDPOINT=
# 可选：构建仅 CPU 精简 PyTorch 镜像时设置 https://download.pytorch.org/whl/cpu
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# -----------------------------------------------------------------------------
# 2. 向量数据库（默认内置 Milvus Lite；可无缝切换独立 Milvus REST v2 集群）
# -----------------------------------------------------------------------------
PICA_MILVUS_BACKEND=lite
PICA_MILVUS_LITE_PATH=data/milvus_lite.db
# 改用外置 Milvus 集群时：将上方改为 rest，并填写下方地址：
# PICA_MILVUS_BACKEND=rest
# PICA_MILVUS_URI=http://milvus:19530

# -----------------------------------------------------------------------------
# 3. 对象存储（默认内置 MinIO；自备 AWS S3 / R2 / OSS 时可填入外部凭据）
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
PICA_AUTO_INIT_PLATFORM_STORAGE=true
PICA_S3_ENDPOINT=http://minio:9000
PICA_S3_REGION=us-east-1
PICA_S3_BUCKET=cinevec-media
# 使用外部 S3 / R2 / OSS 且密钥与 MINIO_ROOT_* 不同时，单独指定：
# PICA_S3_ACCESS_KEY=
# PICA_S3_SECRET_KEY=

# =============================================================================
# Pica Showcase Environment Template
# Copy this file to `backend/.env` and fill in your real service values.
# NEVER commit real passwords, S3 keys, JWT secrets, or tokens to git!
# =============================================================================

# --- Server & Security -------------------------------------------------------
PICA_HOST=127.0.0.1
PICA_PORT=8000
PICA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
PICA_AUTH_ENABLED=false
# Required when PICA_AUTH_ENABLED=true (generate a strong random secret locally):
# PICA_JWT_SECRET=change-me-to-a-long-random-secret

# --- Local Storage, Sampling & Upload Guardrails -----------------------------
PICA_SQLITE_PATH=data/pica.db
PICA_WORK_DIR=data/work
PICA_SAMPLE_INTERVAL_SECONDS=5.0
# Max files allowed per upload request (adjustable 1-500 in Settings UI too):
PICA_MAX_UPLOAD_FILES=20
PICA_WORKER_ENABLED=true
PICA_WORKER_POLL_SECONDS=0.4
PICA_LEASE_SECONDS=30
# Optional absolute path to ffmpeg binary; leave empty to use PATH / imageio-ffmpeg:
# PICA_FFMPEG_PATH=

# --- Platform S3 / MinIO (Stores Previews, Covers & Hosted Originals) --------
# Multiple additional S3 buckets can be registered via Settings/API as read-only
# external asset sources; one bucket acts as the platform storage.
# PICA_S3_ENDPOINT=http://127.0.0.1:9000
# PICA_S3_REGION=us-east-1
# PICA_S3_BUCKET=pica-media
# PICA_S3_ACCESS_KEY=your-minio-access-key
# PICA_S3_SECRET_KEY=your-minio-secret-key

# --- Milvus Vector Database (REST API v2) ------------------------------------
# Vector metadata stores asset_id/version keys for asset-level deletion & lookup.
# PICA_MILVUS_URI=http://127.0.0.1:19530
# PICA_MILVUS_DB=default
# PICA_MILVUS_USER=root
# PICA_MILVUS_PASSWORD=your-milvus-password
# Alternatively, token auth (Zilliz Cloud / RBAC token):
# PICA_MILVUS_TOKEN=
PICA_VECTOR_PROFILE=default

# --- Embedding Encoder Option A: Remote HTTP Service (Recommended) -----------
# PICA_ENCODER_BACKEND=remote_http
# PICA_CLIP_HTTP_BASE_URL=http://127.0.0.1:8001
# PICA_CLIP_HTTP_TIMEOUT_SECONDS=30.0
# PICA_MODEL_FAMILY=chinese_clip
# PICA_MODEL_ARCHITECTURE=ViT-B-16
# PICA_MODEL_ID=chinese-clip-vit-b-16
# PICA_MODEL_VERSION=int8_dynamic
# PICA_MODEL_DIM=512
# PICA_PREPROCESS_VERSION=clip_224_rgb_v1
# PICA_EMBED_HTTP_HEALTH_PATH=/health
# PICA_EMBED_HTTP_TEXT_PATH=/api/v1/embed/text
# PICA_EMBED_HTTP_TEXTS_PATH=/api/v1/embed/texts
# PICA_EMBED_HTTP_IMAGE_PATH=/api/v1/embed/image

# --- Embedding Encoder Option B: Local ONNX (Mutually Exclusive with Option A)
# PICA_ENCODER_BACKEND=local_onnx
# PICA_MODEL_FAMILY=chinese_clip
# PICA_MODEL_ARCHITECTURE=ViT-B-16
# PICA_MODEL_ID=chinese-clip-vit-b-16
# PICA_MODEL_VERSION=fp32
# PICA_MODEL_DIM=512
# PICA_IMAGE_ONNX_PATH=/absolute/path/to/model.img.fp32.onnx
# PICA_TEXT_ONNX_PATH=/absolute/path/to/model.txt.fp32.onnx
# PICA_TOKENIZER_VOCAB_PATH=/absolute/path/to/vocab.txt
# PICA_IMAGE_INPUT_NAME=image
# PICA_IMAGE_OUTPUT_NAME=unnorm_image_features
# PICA_TEXT_INPUT_NAME=text
# PICA_TEXT_OUTPUT_NAME=unnorm_text_features
# PICA_TEXT_CONTEXT_LENGTH=52
# PICA_SUBTITLE_SHARE_TEXT_ENCODER=true
# PICA_SUBTITLE_MODEL_PATH=

# --- Optional EmbeddingGemma 2 Profile (When Supported by HTTP Encoder) ------
# PICA_MODEL_FAMILY=embeddinggemma2
# PICA_MODEL_ID=embeddinggemma-2
# PICA_MODEL_VERSION=unverified
# PICA_MODEL_ARCHITECTURE=embeddinggemma-2
# PICA_MODEL_DIM=768
# PICA_ENCODER_CONTRACT_STATUS=pending_verification
# PICA_TASK_PREFIX_APPLIED_BY=unverified
# PICA_PREPROCESS_VERSION=full_frame_passthrough_v1
